# このファイルを .env という名前でコピーして、値を書き換える。.env は Git に入らない。

# ---- スマホから使う（サーバー） ----
API_KEY=好きな文字列（iPhone のショートカットと同じにする）
NGROK_TOKEN=          # https://dashboard.ngrok.com → Your Authtoken
NGROK_DOMAIN=         # 固定ドメインを使うとき（例: alia-xxxx.ngrok-free.app）。なければ空

# ---- 自宅（位置情報がないときに使う） ----
HOME_LAT=35.6895
HOME_LON=139.6917
HOME_STATION=新宿
COMMUTE_STATION=      # 「次の電車は？」と方面を言わなかったときの行き先（通勤・通学先の駅）

# ---- LLM（Ollama） ----
OLLAMA_MODEL=gemma4:12b

# ---- 音声 ----
VOICEVOX_SPEAKER_ID=14   # 14 = 冥鳴ひまり（ノーマル）
VOICEVOX_VOLUME=1.0      # スマホで小さければ 2.0 など
WHISPER_MODEL=medium     # PC の音声入力で使う。軽くしたいなら small
WHISPER_DEVICE=cpu       # GPU で動かすなら cuda

# ---- 天気（雨の情報） ----
YAHOO_APP_ID=         # https://developer.yahoo.co.jp でアプリ登録 → Client ID

# ---- Notion（メモ・TODO） ----
NOTION_TOKEN=         # https://www.notion.so/my-integrations → シークレット
NOTION_MEMO_PAGE_ID=  # メモ用ページの URL の末尾（32 文字）
NOTION_TODO_PAGE_ID=  # TODO 用ページの URL の末尾（32 文字）

# ---- Google カレンダー（scripts/get_refresh_token.py で取得） ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
